# Erstellt eine Export-Statistik für die BMS-Daten
# catmandu convert BibTeX to Stat --fix ./fix/stat.fix --fields Aufsätze,Monografien,Rezensionen,Abstracts,Zeitschriften,elektronische_Ressource,Ton_Film < dmpbms_${Date}.btx

if any_match(keywords,'german_committee')
   if any_match(abstract,'.*')
      copy_field(abstract,'Abstracts')
   end
end

if any_match(keywords,'german_committee')
   if any_match(abstract_i,'.*')
      copy_field(abstract_i,'Abstracts')
   end
end

if any_match(keywords,'german_committee')
   if any_match(abstract_ii,'.*')
      copy_field(abstract_ii,'Abstracts')
   end
end

if any_match(keywords,'german_committee')
   if any_match(type,'[bd][cdefgmst]')
      copy_field(type,Monografien)
   end
end

if any_match(keywords,'german_committee')
   if any_match(type,'a[bcdegps]')
      copy_field(type,Aufsätze)
   end
end

if any_match(keywords,'german_committee')
   if any_match(type,'er')
      copy_field(type,elektronische_Ressource)
   end
end

if any_match(keywords,'german_committee')
   if any_match(type,'m[pr]')
      copy_field(type,Ton_Film)
   end
end

if any_match(keywords,'german_committee')
   if any_match(type,'r[abcdefprstvx]')
      copy_field(type,Rezensionen)
   end
end

if any_match(keywords,'german_committee')
   if any_match(type,'bp')
      copy_field(type,Zeitschriften)
   end
end